{
  "id": "my-plugin",
  "name": "我的插件",
  "version": "1.0",
  "desc": "一句话说明插件做什么（管理页/市场卡片显示）",
  "author": "你的名字",
  "enabled": true,
  "routes": "routes.py:bp",
  "icon": "🔌",
  "permissions": ["network"],
  "nav": { "tab": "myplugin", "label": "我的插件", "icon": "🔌" },
  "assets": { "css": ["style.css"], "js": ["page.js"] },
  "warmup": "warmup.py:run",
  "settings": {
    "fields": [
      { "key": "page_size", "type": "int", "label": "每页条数",
        "default": 20, "min": 5, "max": 100 },
      { "key": "verbose", "type": "bool", "label": "详细日志", "default": false },
      { "key": "mode", "type": "select", "label": "模式",
        "default": "std",
        "options": [{ "value": "std", "label": "标准" },
                    { "value": "fast", "label": "快速" }] }
    ]
  }
}
